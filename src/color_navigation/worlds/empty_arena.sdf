<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="empty_arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><exponential>0.001</exponential></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- HOME BASE DOCKING PAD at (0.0, 0.0) -->
    <model name="home_docking_pad">
      <static>true</static>
      <pose>0.0 0.0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="dock_surface">
          <geometry><cylinder><radius>0.35</radius><length>0.002</length></cylinder></geometry>
          <material><ambient>0.2 0.25 0.35 0.8</ambient><diffuse>0.2 0.25 0.35 0.8</diffuse></material>
        </visual>
        <visual name="dock_center_line">
          <pose>0.1 0 0.002 0 0 0</pose>
          <geometry><box><size>0.2 0.04 0.002</size></box></geometry>
          <material><ambient>0.1 0.8 1.0 1.0</ambient><diffuse>0.1 0.8 1.0 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- NO PRESENTED OBJECT: Robot will wait until you manually place or spawn one! -->

    <!-- RED PILLAR at (2.5, 1.8) -->
    <model name="red_pillar">
      <static>true</static>
      <pose>2.5 1.8 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="pillar">
          <geometry><cylinder><radius>0.2</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.9 0.05 0.05 1.0</ambient><diffuse>0.9 0.05 0.05 1.0</diffuse></material>
        </visual>
        <visual name="target_pad">
          <pose>0 0 -0.599 0 0 0</pose>
          <geometry><cylinder><radius>0.45</radius><length>0.002</length></cylinder></geometry>
          <material><ambient>0.85 0.1 0.1 0.6</ambient><diffuse>0.85 0.1 0.1 0.6</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- GREEN PILLAR at (3.5, 0.0) -->
    <model name="green_pillar">
      <static>true</static>
      <pose>3.5 0.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="pillar">
          <geometry><cylinder><radius>0.2</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.05 0.85 0.05 1.0</ambient><diffuse>0.05 0.85 0.05 1.0</diffuse></material>
        </visual>
        <visual name="target_pad">
          <pose>0 0 -0.599 0 0 0</pose>
          <geometry><cylinder><radius>0.45</radius><length>0.002</length></cylinder></geometry>
          <material><ambient>0.1 0.85 0.1 0.6</ambient><diffuse>0.1 0.85 0.1 0.6</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- WHITE PILLAR at (2.5, -1.8) -->
    <model name="white_pillar">
      <static>true</static>
      <pose>2.5 -1.8 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="pillar">
          <geometry><cylinder><radius>0.2</radius><length>1.2</length></cylinder></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1.0</ambient>
            <diffuse>0.95 0.95 0.95 1.0</diffuse>
            <specular>0.5 0.5 0.5 1.0</specular>
          </material>
        </visual>
        <visual name="target_pad">
          <pose>0 0 -0.599 0 0 0</pose>
          <geometry><cylinder><radius>0.45</radius><length>0.002</length></cylinder></geometry>
          <material><ambient>0.9 0.9 0.9 0.6</ambient><diffuse>0.9 0.9 0.9 0.6</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>

