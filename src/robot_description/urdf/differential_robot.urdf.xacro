<?xml version="1.0"?>

<robot name="colour_detection_robot"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ================================================= -->
    <!-- MATERIALS                                         -->
    <!-- ================================================= -->

    <material name="red">
        <color rgba="0.85 0.1 0.1 1.0"/>
    </material>

    <material name="yellow">
        <color rgba="1.0 0.8 0.0 1.0"/>
    </material>

    <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
    </material>

    <material name="grey">
        <color rgba="0.35 0.35 0.35 1.0"/>
    </material>


    <!-- ================================================= -->
    <!-- ROBOT PARAMETERS                                  -->
    <!-- ================================================= -->

    <xacro:property name="wheel_radius" value="0.05"/>
    <xacro:property name="wheel_width" value="0.03"/>

    <xacro:property name="wheel_separation" value="0.23"/>
    <xacro:property name="wheel_base" value="0.24"/>


    <!-- ================================================= -->
    <!-- BASE FOOTPRINT                                    -->
    <!-- ================================================= -->

    <link name="base_footprint"/>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>


    <!-- ================================================= -->
    <!-- MAIN CHASSIS                                      -->
    <!-- ================================================= -->

    <link name="base_link">

        <visual>
            <origin xyz="0 0 0.07" rpy="0 0 0"/>

            <geometry>
                <box size="0.40 0.20 0.10"/>
            </geometry>

            <material name="red"/>
        </visual>

        <collision>
            <origin xyz="0 0 0.07" rpy="0 0 0"/>

            <geometry>
                <box size="0.40 0.20 0.10"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.07" rpy="0 0 0"/>

            <mass value="5.0"/>

            <inertia
                ixx="0.02083"
                ixy="0.0"
                ixz="0.0"
                iyy="0.07083"
                iyz="0.0"
                izz="0.08333"/>
        </inertial>

    </link>


    <!-- ================================================= -->
    <!-- FRONT LEFT WHEEL                                  -->
    <!-- ================================================= -->

    <link name="front_left_wheel_link">

        <visual>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>

            <geometry>
                <cylinder radius="${wheel_radius}"
                          length="${wheel_width}"/>
            </geometry>

            <material name="yellow"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>

            <geometry>
                <cylinder radius="${wheel_radius}"
                          length="${wheel_width}"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>

            <mass value="0.5"/>

            <inertia
                ixx="0.00035"
                ixy="0.0"
                ixz="0.0"
                iyy="0.000625"
                iyz="0.0"
                izz="0.00035"/>
        </inertial>

    </link>

    <joint name="front_left_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="front_left_wheel_link"/>

        <origin xyz="${wheel_base/2} ${wheel_separation/2} ${wheel_radius}" rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

        <limit effort="20.0" velocity="20.0"/>

        <dynamics damping="0.02" friction="0.005"/>

    </joint>


    <!-- ================================================= -->
    <!-- FRONT RIGHT WHEEL                                 -->
    <!-- ================================================= -->

    <link name="front_right_wheel_link">

        <visual>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>

            <geometry>
                <cylinder radius="${wheel_radius}"
                          length="${wheel_width}"/>
            </geometry>

            <material name="yellow"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>

            <geometry>
                <cylinder radius="${wheel_radius}"
                          length="${wheel_width}"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>

            <mass value="0.5"/>

            <inertia
                ixx="0.00035"
                ixy="0.0"
                ixz="0.0"
                iyy="0.000625"
                iyz="0.0"
                izz="0.00035"/>
        </inertial>

    </link>

    <joint name="front_right_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="front_right_wheel_link"/>

        <origin xyz="${wheel_base/2} ${-wheel_separation/2} ${wheel_radius}" rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

        <limit effort="20.0" velocity="20.0"/>

        <dynamics damping="0.02" friction="0.005"/>

    </joint>


    <!-- ================================================= -->
    <!-- REAR LEFT WHEEL                                   -->
    <!-- ================================================= -->

    <link name="rear_left_wheel_link">

        <visual>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>

            <geometry>
                <cylinder radius="${wheel_radius}"
                          length="${wheel_width}"/>
            </geometry>

            <material name="yellow"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>

            <geometry>
                <cylinder radius="${wheel_radius}"
                          length="${wheel_width}"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>

            <mass value="0.5"/>

            <inertia
                ixx="0.00035"
                ixy="0.0"
                ixz="0.0"
                iyy="0.000625"
                iyz="0.0"
                izz="0.00035"/>
        </inertial>

    </link>

    <joint name="rear_left_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="rear_left_wheel_link"/>

        <origin xyz="${-wheel_base/2} ${wheel_separation/2} ${wheel_radius}" rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

        <limit effort="20.0" velocity="20.0"/>

        <dynamics damping="0.02" friction="0.005"/>

    </joint>


    <!-- ================================================= -->
    <!-- REAR RIGHT WHEEL                                  -->
    <!-- ================================================= -->

    <link name="rear_right_wheel_link">

        <visual>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>

            <geometry>
                <cylinder radius="${wheel_radius}"
                          length="${wheel_width}"/>
            </geometry>

            <material name="yellow"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>

            <geometry>
                <cylinder radius="${wheel_radius}"
                          length="${wheel_width}"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>

            <mass value="0.5"/>

            <inertia
                ixx="0.00035"
                ixy="0.0"
                ixz="0.0"
                iyy="0.000625"
                iyz="0.0"
                izz="0.00035"/>
        </inertial>

    </link>

    <joint name="rear_right_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="rear_right_wheel_link"/>

        <origin xyz="${-wheel_base/2} ${-wheel_separation/2} ${wheel_radius}" rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

        <limit effort="20.0" velocity="20.0"/>

        <dynamics damping="0.02" friction="0.005"/>

    </joint>


    <!-- ================================================= -->
    <!-- FRONT RGB CAMERA                                  -->
    <!-- ================================================= -->

    <link name="camera_link">

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>

            <geometry>
                <box size="0.04 0.05 0.03"/>
            </geometry>

            <material name="black"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>

            <geometry>
                <box size="0.04 0.05 0.03"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>

            <mass value="0.05"/>

            <inertia
                ixx="0.0000142"
                ixy="0"
                ixz="0"
                iyy="0.0000104"
                iyz="0"
                izz="0.0000171"/>
        </inertial>

    </link>

    <joint name="camera_joint" type="fixed">

        <parent link="base_link"/>
        <child link="camera_link"/>

        <!-- Front of robot, above chassis -->

        <origin xyz="0.18 0 0.135"
                rpy="0 0 0"/>

    </joint>

    <!-- Camera Optical Joint & Link (ROS Optical Frame: Z forward, X right, Y down) -->

    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_optical_link"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="camera_optical_link"/>


    <!-- ================================================= -->
    <!-- GAZEBO CAMERA SENSOR                              -->
    <!-- ================================================= -->

    <gazebo reference="camera_link">

        <sensor name="front_camera" type="camera">

            <pose>0 0 0 0 0 0</pose>

            <always_on>true</always_on>

            <update_rate>30</update_rate>

            <visualize>true</visualize>

            <topic>/camera/image</topic>

            <camera_info_topic>/camera/camera_info</camera_info_topic>

            <gz_frame_id>camera_optical_link</gz_frame_id>
            <ignition_frame_id>camera_optical_link</ignition_frame_id>

            <camera>

                <horizontal_fov>1.047</horizontal_fov>

                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>

                <clip>
                    <near>0.05</near>
                    <far>10.0</far>
                </clip>

            </camera>

        </sensor>

    </gazebo>


    <!-- ================================================= -->
    <!-- GAZEBO PHYSICS AND FRICTION                       -->
    <!-- ================================================= -->

    <gazebo reference="base_link">
        <material>Gazebo/Red</material>
        <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="camera_link">
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="front_left_wheel_link">
        <material>Gazebo/Yellow</material>
        <mu1>1.0</mu1>
        <mu2>0.05</mu2>
        <fdir1>1 0 0</fdir1>
        <kp>100000.0</kp>
        <kd>10.0</kd>
        <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="front_right_wheel_link">
        <material>Gazebo/Yellow</material>
        <mu1>1.0</mu1>
        <mu2>0.05</mu2>
        <fdir1>1 0 0</fdir1>
        <kp>100000.0</kp>
        <kd>10.0</kd>
        <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="rear_left_wheel_link">
        <material>Gazebo/Yellow</material>
        <mu1>1.0</mu1>
        <mu2>0.05</mu2>
        <fdir1>1 0 0</fdir1>
        <kp>100000.0</kp>
        <kd>10.0</kd>
        <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="rear_right_wheel_link">
        <material>Gazebo/Yellow</material>
        <mu1>1.0</mu1>
        <mu2>0.05</mu2>
        <fdir1>1 0 0</fdir1>
        <kp>100000.0</kp>
        <kd>10.0</kd>
        <self_collide>false</self_collide>
    </gazebo>


    <!-- ================================================= -->
    <!-- GAZEBO DIFFERENTIAL DRIVE SYSTEM                  -->
    <!-- ================================================= -->

    <gazebo>

        <plugin
            filename="ignition-gazebo-diff-drive-system"
            name="ignition::gazebo::systems::DiffDrive">

            <left_joint>front_left_wheel_joint</left_joint>
            <left_joint>rear_left_wheel_joint</left_joint>

            <right_joint>front_right_wheel_joint</right_joint>
            <right_joint>rear_right_wheel_joint</right_joint>

            <wheel_separation>${wheel_separation}</wheel_separation>

            <wheel_radius>${wheel_radius}</wheel_radius>

            <max_wheel_torque>50</max_wheel_torque>

            <odom_publish_frequency>50</odom_publish_frequency>

            <topic>/cmd_vel</topic>

            <odom_topic>/model/colour_detection_robot/odometry_raw</odom_topic>

            <tf_topic>/model/colour_detection_robot/tf_raw</tf_topic>

            <frame_id>odom</frame_id>

            <child_frame_id>base_footprint</child_frame_id>

            <max_linear_acceleration>5.0</max_linear_acceleration>
            <min_linear_acceleration>-5.0</min_linear_acceleration>

            <max_angular_acceleration>10.0</max_angular_acceleration>
            <min_angular_acceleration>-10.0</min_angular_acceleration>

        </plugin>

        <!-- GROUND-TRUTH ODOMETRY PUBLISHER (Zero Wheel-Slip Drift) -->
        <plugin
            filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
            <odom_frame>odom</odom_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
            <odom_topic>/odom</odom_topic>
            <tf_topic>/tf</tf_topic>
            <odom_publish_frequency>50</odom_publish_frequency>
            <dimensions>2</dimensions>
        </plugin>


        <!-- JOINT STATE PUBLISHER -->

        <plugin
            filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">

            <topic>/joint_states</topic>

            <joint_name>front_left_wheel_joint</joint_name>
            <joint_name>front_right_wheel_joint</joint_name>

            <joint_name>rear_left_wheel_joint</joint_name>
            <joint_name>rear_right_wheel_joint</joint_name>

        </plugin>

    </gazebo>

</robot>
